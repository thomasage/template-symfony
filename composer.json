{
    "name": "thomasage/symfony-template",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "babdev/pagerfanta-bundle": "^4.6",
        "doctrine/dbal": "^4.4.4",
        "doctrine/doctrine-bundle": "^3.3.1",
        "doctrine/doctrine-migrations-bundle": "^3.7.0",
        "doctrine/orm": "^3.6.8",
        "endroid/qr-code": "^6.1.3",
        "pagerfanta/doctrine-orm-adapter": "^4.8.0",
        "pagerfanta/twig": "^4.8.0",
        "scheb/2fa-bundle": "^8.6.1",
        "scheb/2fa-email": "^8.6.1",
        "scheb/2fa-totp": "^8.6.1",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11.0",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/rate-limiter": "8.1.*",
        "symfony/redis-messenger": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^2.12|^3.24.0",
        "twig/intl-extra": "^3.26.0",
        "twig/twig": "^2.12|^3.28.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "ergebnis/phpstan-rules": "^2.13.1",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.8",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^12.5.33",
        "rector/rector": "^2.6.2",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/phpunit-bridge": "^8.1.4",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "symplify/config-transformer": "^12.5.0",
        "vincentlanglet/twig-cs-fixer": "^3.14.0",
        "zenstruck/browser": "^1.10.1",
        "zenstruck/foundry": "^2.11.3",
        "zenstruck/messenger-test": "^1.15"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "qa": [
            "@qa:rector",
            "@qa:cs-fix",
            "@qa:twig-fix",
            "@qa:phpstan",
            "@qa:phpunit"
        ],
        "qa:cs-fix": "php-cs-fixer fix --allow-risky=yes",
        "qa:phpstan": "phpstan --memory-limit=1G",
        "qa:phpunit": "bin/phpunit",
        "qa:rector": "rector",
        "qa:twig-fix": "twig-cs-fixer lint --fix templates"
    },
    "scripts-descriptions": {
        "qa:cs-fix": "A tool to automatically fix PHP Coding Standards issues",
        "qa:phpstan": "Find Bugs Without Writing Tests",
        "qa:phpunit": "The PHP Testing Framework",
        "qa:rector": "Instant Upgrades and Automated Refactoring",
        "qa:twig-fix": "A tool to automatically fix Twig Coding Standard Issues"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
