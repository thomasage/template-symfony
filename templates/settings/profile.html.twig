{% extends 'base.html.twig' %}

{% trans_default_domain 'settings' %}

{% block title %}{{ 'page_title'|trans }} — ACME{% endblock %}

{% block body %}

    <div class="mx-auto max-w-2xl px-4 py-10">

        <h1 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white">
            {{ 'page_title'|trans }}
        </h1>

        {{ form_start(form, {attr: {class: 'mt-8'}}) }}
            {{ form_row(form.email) }}

            <button type="submit"
                    class="flex w-full justify-center rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 sm:w-auto dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-white dark:focus:ring-offset-gray-950">
                {{ 'actions.save'|trans(domain: 'messages') }}
            </button>
        {{ form_end(form) }}

        <section class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-800">
            <h2 class="text-lg font-semibold tracking-tight text-gray-900 dark:text-white">
                {{ '2fa.title'|trans }}
            </h2>

            {% if app.user.isTotpAuthenticationEnabled %}

                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
                    {{ '2fa.enabled'|trans }}
                </p>

                <a href="{{ path('app_settings_2fa_disable') }}"
                   class="mt-4 inline-flex rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-900 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800 dark:focus:ring-white">
                    {{ '2fa.disable'|trans }}
                </a>

            {% else %}

                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
                    {{ '2fa.disabled'|trans }}
                </p>

                <a href="{{ path('app_settings_2fa_setup') }}"
                   class="mt-4 inline-flex rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-900 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800 dark:focus:ring-white">
                    {{ '2fa.setup'|trans }}
                </a>

            {% endif %}
        </section>

    </div>

{% endblock %}
