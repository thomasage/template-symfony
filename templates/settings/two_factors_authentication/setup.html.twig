{% extends 'base.html.twig' %}

{% trans_default_domain 'settings' %}

{% block title %}{{ '2fa.setup'|trans }} — ACME{% endblock %}

{% block body %}

    <div class="mx-auto max-w-2xl px-4 py-10">

        <h1 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white">
            {{ '2fa.setup'|trans }}
        </h1>

        <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
            Scan the QR code using Google Authenticator or another TOTP app:
        </p>

        <img src="{{ path('app_settings_2fa_qrcode') }}" alt="QR Code"
             class="mt-4 rounded-lg border border-gray-200 bg-white p-2 dark:border-gray-800">

        <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
            Secret : <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-gray-900 dark:bg-gray-800 dark:text-gray-100">{{ secret }}</code>
        </p>

        {{ form_start(form, {attr: {class: 'mt-8'}}) }}
            {{ form_widget(form) }}

            <div class="flex flex-wrap items-center gap-3">
                <button type="submit"
                        class="inline-flex justify-center rounded-lg bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-white dark:focus:ring-offset-gray-950">
                    {{ 'actions.enable'|trans(domain: 'messages') }}
                </button>
                <a href="{{ path('app_settings_profile') }}"
                   class="text-sm font-medium text-gray-600 underline-offset-2 hover:text-gray-900 hover:underline dark:text-gray-400 dark:hover:text-white">
                    {{ 'actions.cancel'|trans(domain: 'messages') }}
                </a>
            </div>
        {{ form_end(form) }}

    </div>

{% endblock %}
